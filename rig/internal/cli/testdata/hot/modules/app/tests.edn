#kaocha/v1
{:reporter [kaocha.report/documentation]
 :color? false
 :plugins [:kaocha.plugin/filter]
 :tests
 [{:id :unit
   :type :kaocha.type/clojure.test
   :ns-patterns ["-test$"]
   :skip-meta [:integration]}
  {:id :integration
   :type :kaocha.type/clojure.test
   :ns-patterns ["-test$"]
   :focus-meta [:integration]}]}
